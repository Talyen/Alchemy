{
  "compilerOptions": {
    "target": "ES2024",
    "useDefineForClassFields": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "baseUrl": ".",
    "paths": {
      "@/features/alchemy/stores/*": ["./src/features/alchemy/shared/stores/*"],
      "@/features/alchemy/ui/*": ["./src/features/alchemy/shared/ui/*"],
      "@/features/alchemy/storage": ["./src/features/alchemy/shared/storage/index"],
      "@/features/alchemy/storage/*": ["./src/features/alchemy/shared/storage/*"],
      "@/features/alchemy/battle/*": ["./src/features/alchemy/run-loop/battle/*"],
      "@/features/alchemy/navigation/*": ["./src/features/alchemy/run-loop/navigation/*"],
      "@/features/alchemy/shop/*": ["./src/features/alchemy/run-loop/shop/*"],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts"]
}
