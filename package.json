{
  "name": "alchemy",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "sounds:optimize": "node scripts/optimize-sounds.mjs",
    "music:optimize": "node scripts/optimize-music.mjs",
    "predev": "node scripts/stop-dev-server.mjs && npm run assets:optimize && npm run sounds:optimize && npm run music:optimize",
    "predev:desktop": "node scripts/stop-dev-server.mjs && npm run assets:optimize && npm run sounds:optimize && npm run music:optimize",
    "prebuild": "npm run assets:optimize && npm run sounds:optimize && npm run music:optimize",
    "prebuild:desktop": "npm run assets:optimize && npm run sounds:optimize && npm run music:optimize",
    "dev": "vite",
    "dev:desktop": "concurrently \"vite --mode desktop --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build",
    "build:web": "npm run build",
    "compile:desktop": "tsc && vite build --mode desktop",
    "build:desktop": "tsc && vite build --mode desktop",
    "package:win": "npm run compile:desktop && cross-env NODE_OPTIONS=--no-deprecation electron-builder --win --dir",
    "package:win:full": "npm run build:desktop && cross-env NODE_OPTIONS=--no-deprecation electron-builder --win --dir",
    "dist:win": "npm run build:desktop && cross-env NODE_OPTIONS=--no-deprecation electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project chromium",
    "test:e2e:smoke": "playwright test --project chromium --grep @smoke",
    "test:e2e:critical": "playwright test --project chromium --grep @critical",
    "test:e2e:prepush": "cross-env PLAYWRIGHT_VITE_MODE=preview CI=true npm run test:e2e:critical",
    "test:e2e:preview": "cross-env PLAYWRIGHT_VITE_MODE=preview PLAYWRIGHT_E2E_FULL=1 CI=true playwright test --project chromium",
    "test:e2e:ui": "playwright test --project chromium --ui",
    "balance:sim": "cross-env ALCHEMY_BALANCE_SIM=1 vitest run tests/balance/balance-report.test.ts --reporter=verbose && start \"\" reports\\balance-report.html",
    "check": "npm ci --dry-run && npm run lint:ci && npm test && npm run build",
    "check:push": "npm run check && npm run test:e2e:prepush",
    "lint": "eslint .",
    "lint:ci": "npm run format:check && npm run lint && npm run deadcode",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "deadcode": "knip",
    "deadcode:strict": "knip --strict --include-entry-exports",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "prepare": "lefthook install",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.2.6",
    "steamworks.js": "^0.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commit-and-tag-version": "^12.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "ffmpeg-static": "^5.3.0",
    "immer": "^11.1.8",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "lefthook": "^2.1.6",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vite-plugin-checker": "^0.13.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.3",
    "zod": "^4.4.3"
  },
  "knip": {
    "entry": [
      "src/App.tsx",
      "src/lib/game-data/index.ts",
      "src/lib/battle/index.ts",
      "src/lib/validation/index.ts",
      "src/features/alchemy/shared/stores/run-session-facade.ts",
      "src/features/alchemy/use-alchemy-run-controller.ts",
      "src/features/alchemy/use-run-navigation.ts",
      "src/features/alchemy/use-battle-controller.ts",
      "src/features/alchemy/use-shop-controller.ts",
      "src/features/alchemy/use-labyrinth-controller.ts",
      "scripts/*.mjs",
      "desktop/*.cjs"
    ],
    "project": [
      "src/**/*.{ts,tsx}",
      "scripts/**/*.mjs",
      "desktop/**/*.cjs",
      "tests/**/*.{ts,tsx}"
    ],
    "ignoreBinaries": [
      "start"
    ],
    "ignoreIssues": {
      "tests/playwright-tags.ts": ["exports"],
      "src/features/alchemy/shared/stores/active-run-store.ts": ["exports", "duplicates"],
      "src/features/alchemy/shared/stores/run-store-types.ts": ["exports"]
    },
    "ignoreDependencies": [
      "electron",
      "react",
      "react-dom",
      "zustand",
      "@radix-ui/react-switch"
    ]
  },
  "build": {
    "appId": "com.alchemy.game",
    "productName": "Alchemy",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/steamworks.js/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    }
  }
}
