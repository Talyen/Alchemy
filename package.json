{
  "name": "alchemy",
  "private": true,
  "version": "0.1.0",
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "ffmpeg-static": true,
    "lefthook": true,
    "sharp": true,
    "@sentry/cli": true,
    "@swc/core": true,
    "fsevents": false
  },
  "engines": {
    "node": "^24.18.0",
    "npm": "^11.0.0"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "assets:optimize": "node scripts/assets.mjs --optimize",
    "assets:optimize:art": "node scripts/optimize-assets.mjs",
    "assets:optimize:sounds": "node scripts/optimize-sounds.mjs",
    "assets:optimize:music": "node scripts/optimize-music.mjs",
    "assets:check": "node scripts/assets.mjs --check",
    "audio:review": "node scripts/audio-review.mjs",
    "agent:browser": "node scripts/agent-browser.mjs",
    "predev": "node scripts/prune-transient-artifacts.mjs && node scripts/stop-dev-server.mjs && npm run assets:check:outputs",
    "predev:desktop": "npm run predev && node scripts/sync-steam-appid.mjs",
    "dev": "vite",
    "dev:checked": "cross-env ALCHEMY_ENABLE_CHECKER=1 vite",
    "dev:desktop": "concurrently --kill-others --success first \"vite --mode desktop --host 127.0.0.1\" \"node scripts/wait-dev-server.mjs && electron .\"",
    "build": "node scripts/build-verified.mjs",
    "build:desktop": "node scripts/build-verified.mjs --desktop",
    "dist:desktop": "node scripts/dist-desktop.mjs --build",
    "package:win": "npm run dist:desktop -- --dir",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "generate:patch-notes": "node scripts/generate-patch-notes.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "content:audit": "node scripts/content-audit.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:all": "node scripts/audit.mjs --all",
    "ci:summarize": "node scripts/ci-summarize.mjs",
    "verify": "node scripts/verify-changed.mjs",
    "check": "node scripts/check.mjs",
    "runs:show": "node scripts/show-runs.mjs",
    "compact": "node scripts/run-compact.mjs",
    "context": "node scripts/agent-context.mjs",
    "review:diff": "node scripts/agent-diff.mjs",
    "review:status": "node scripts/agent-diff.mjs --status",
    "new:plan": "node scripts/new-plan.mjs",
    "finish:plans": "node scripts/finish-plans.mjs",
    "plans:check": "node scripts/check-docs.mjs --plans-only",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:check:final": "node scripts/check-docs.mjs --final",
    "prune:transient": "node scripts/prune-transient-artifacts.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "changelog:promote": "node scripts/release-changelog.mjs",
    "sync:version": "node scripts/sync-version-metadata.mjs",
    "sync:steam-appid": "node scripts/sync-steam-appid.mjs",
    "sync:gear-art": "node scripts/sync-generated.mjs --gear-only",
    "sync:art": "node scripts/sync-generated.mjs --art-only",
    "sync:generated": "node scripts/sync-generated.mjs",
    "check:generated": "node scripts/sync-generated.mjs --check",
    "test:ship:unit": "node scripts/run-ship-unit.mjs",
    "test:ship:e2e": "node scripts/run-compact.mjs playwright test tests/e2e/specs/save-persistence.spec.ts tests/e2e/specs/save-error-paths.spec.ts --project=chromium",
    "test:ship:desktop": "node scripts/run-compact.mjs playwright test --config playwright.electron.config.ts",
    "check:ship": "npm run lint:ci && npm run test:ship:unit && npm run assets:check:outputs && npm run build:desktop && npm run check:bundle",
    "check:ship:full": "npm run check:ship && npm run test:ship:e2e",
    "verify:release-version": "node scripts/verify-release.mjs --skip-package",
    "verify:release": "node scripts/verify-release.mjs",
    "steam:upload": "node scripts/steam-upload.mjs",
    "steam:upload:dry-run": "cross-env STEAM_UPLOAD_DRY_RUN=1 node scripts/steam-upload.mjs",
    "clean": "node scripts/clean-dev-artifacts.mjs",
    "clean:all": "node scripts/clean-dev-artifacts.mjs --all",
    "test": "node scripts/run-local-tests.mjs",
    "test:watch": "vitest",
    "test:coverage": "node scripts/run-compact.mjs vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "cross-env PLAYWRIGHT_VITE_MODE=preview node scripts/run-compact.mjs playwright test --project=chromium",
    "test:e2e:dev": "cross-env PLAYWRIGHT_VITE_MODE=dev node scripts/run-compact.mjs playwright test --project=chromium",
    "test:e2e:critical": "cross-env PLAYWRIGHT_VITE_MODE=preview node scripts/run-compact.mjs playwright test --project=chromium --grep @critical",
    "test:e2e:route": "node scripts/run-e2e-route.mjs",
    "test:e2e:debug": "cross-env PLAYWRIGHT_VITE_MODE=preview playwright test --project=chromium --headed --trace on",
    "test:e2e:full": "cross-env PLAYWRIGHT_VITE_MODE=preview PLAYWRIGHT_E2E_FULL=1 CI=true node scripts/run-compact.mjs playwright test --project=chromium",
    "test:e2e:nightly": "cross-env PLAYWRIGHT_VITE_MODE=preview PLAYWRIGHT_E2E_FULL=1 PLAYWRIGHT_NIGHTLY=1 CI=true node scripts/run-compact.mjs playwright test --project=chromium",
    "test:e2e:timings": "cross-env PLAYWRIGHT_JSON_OUTPUT_NAME=reports/e2e-results.json PLAYWRIGHT_VITE_MODE=preview PLAYWRIGHT_E2E_FULL=1 CI=true node scripts/run-compact.mjs playwright test --project=chromium --reporter=json",
    "test:e2e:audit": "node scripts/analyze-e2e.mjs",
    "perf": "node scripts/run-performance.mjs",
    "perf:trace": "node scripts/run-performance.mjs --trace",
    "perf:compare": "node scripts/run-performance.mjs --compare",
    "balance:sim": "node scripts/run-balance-report.mjs && node scripts/open-report.mjs reports/balance-findings.html",
    "balance:sim:full": "cross-env ALCHEMY_BALANCE_MODE=full npm run balance:sim",
    "balance:playthrough": "node scripts/run-playthrough.mjs",
    "balance:playthrough:replay": "node scripts/run-playthrough.mjs",
    "balance:playthrough:compare": "node scripts/run-playthrough.mjs",
    "test:playthrough": "node scripts/run-compact.mjs vitest run --config vitest.playthrough.config.ts",
    "balance:loot": "node scripts/run-loot-report.mjs",
    "test:balance": "node scripts/run-compact.mjs vitest run --config vitest.balance.config.ts",
    "check:static": "concurrently --max-process 4 --names generated,format,typecheck,oxlint \"npm run check:generated\" \"npm run format:check\" \"npm run typecheck:all\" \"npm run lint\"",
    "lint": "node scripts/run-compact.mjs oxlint . --format stylish --max-warnings=0",
    "lint:verbose": "oxlint . --format stylish --max-warnings=0",
    "lint:boundaries": "depcruise src --config dependency-cruiser.config.mjs --output-type err",
    "lint:architecture-smoke": "node scripts/lint-architecture-smoke.mjs",
    "typecheck": "node scripts/run-compact.mjs tsc --noEmit",
    "typecheck:verbose": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "typecheck:all": "node scripts/run-compact.mjs concurrently \"tsc --noEmit\" \"tsc -p tsconfig.test.json --noEmit\"",
    "typecheck:all:verbose": "concurrently \"tsc --noEmit\" \"tsc -p tsconfig.test.json --noEmit\"",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "lint:ci": "node scripts/lint-ci.mjs",
    "format": "node scripts/run-prettier.mjs --write",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "deadcode": "node scripts/run-compact.mjs knip --treat-config-hints-as-errors",
    "deadcode:verbose": "knip --treat-config-hints-as-errors",
    "deadcode:entry-exports": "knip --config knip.entry-exports.config.js --include-entry-exports --treat-config-hints-as-errors",
    "deadcode:fix": "knip --fix --allow-remove-files --format",
    "format:check": "node scripts/run-prettier.mjs --check",
    "prepare": "lefthook install",
    "release": "node scripts/release.mjs",
    "release:hotfix": "node scripts/release.mjs --hotfix",
    "test:e2e:verbose": "cross-env PLAYWRIGHT_VITE_MODE=preview node scripts/run-compact.mjs --live playwright test --project=chromium",
    "demo:playtest": "node scripts/play-demo.mjs",
    "test:interactions": "node scripts/run-interactions.mjs",
    "test:unit": "node scripts/run-compact.mjs vitest run",
    "test:full": "node scripts/run-compact.mjs vitest run",
    "check:full": "node scripts/check.mjs --full",
    "verify:full": "node scripts/verify-changed.mjs --full",
    "assets:check:outputs": "node scripts/assets.mjs --check --outputs-only",
    "test:smoke": "node scripts/run-local-tests.mjs",
    "verify:unit": "node scripts/verify-changed.mjs --unit",
    "test:full:verbose": "node scripts/run-compact.mjs --live vitest run",
    "i18n:fonts": "node scripts/localization/subset-fonts.mjs",
    "i18n:prepare": "node scripts/localization.mjs prepare",
    "i18n:finish": "node scripts/localization.mjs finish",
    "i18n:extract": "node scripts/localization.mjs extract",
    "i18n:tasks": "node scripts/localization.mjs tasks",
    "i18n:apply": "node scripts/localization.mjs apply",
    "i18n:check": "node scripts/localization.mjs check",
    "check:dependencies": "npm audit --audit-level=moderate",
    "test:visual": "cross-env PLAYWRIGHT_VITE_MODE=preview node scripts/run-compact.mjs playwright test --config playwright.visual.config.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@radix-ui/react-select": "^2.1.4",
    "@sentry/electron": "^7.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.6",
    "immer": "^11.1.8",
    "lucide-react": "^1.37.0",
    "motion": "^12.38.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.17",
    "steamworks.js": "^0.4.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@electron/get": "^5.1.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.4.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "commit-and-tag-version": "^12.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "18.5.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "knip": "6.14.2",
    "lefthook": "^2.1.6",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-checker": "0.14.5",
    "vitest": "^4.1.12",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "@swc/core": "1.16.13",
    "@axe-core/playwright": "^4.14.0",
    "eslint": "^10.0.0",
    "@electron-internal/extract-zip": "^1.0.1"
  },
  "build": {
    "appId": "com.alchemy.game",
    "productName": "Alchemy",
    "asar": true,
    "afterPack": "desktop/after-pack.cjs",
    "asarUnpack": [
      "**/node_modules/steamworks.js/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "!**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icons/icon.ico"
    }
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    },
    "typed-rest-client": {
      "qs": "^6.16.1"
    }
  }
}
