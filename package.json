{
  "name": "alchemy",
  "private": true,
  "version": "0.1.0",
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "ffmpeg-static": true,
    "lefthook": true,
    "sharp": true
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=11"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:check": "node scripts/check-prepared-assets.mjs",
    "predev": "node scripts/prune-transient-artifacts.mjs && node scripts/stop-dev-server.mjs && node scripts/prepare-assets.mjs",
    "predev:desktop": "npm run predev && node scripts/sync-steam-appid.mjs",
    "prebuild": "node scripts/prune-transient-artifacts.mjs && node scripts/sync-version-metadata.mjs && node scripts/prepare-assets.mjs",
    "prebuild:desktop": "npm run prebuild && node scripts/sync-steam-appid.mjs",
    "dev": "vite",
    "dev:checked": "cross-env ALCHEMY_ENABLE_CHECKER=1 vite",
    "dev:desktop": "concurrently \"vite --mode desktop --host 127.0.0.1\" \"node scripts/wait-dev-server.mjs && electron .\"",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "dist:desktop": "npm run build:desktop && node scripts/dist-desktop.mjs",
    "package:win": "npm run dist:desktop -- --dir",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "generate:patch-notes": "node scripts/generate-patch-notes.mjs",
    "content:audit": "node scripts/content-audit.mjs",
    "audit": "node scripts/audit.mjs --all",
    "audit:all": "node scripts/audit-all.mjs",
    "ci:routing": "node scripts/check-ci-routing.mjs",
    "ci:summarize": "node scripts/ci-summarize.mjs",
    "ci:verify-plan": "node scripts/ci-verify-plan.mjs",
    "check:test-owners": "node scripts/check-test-owners.mjs",
    "verify": "node scripts/verify.mjs --changed",
    "verify:changed": "node scripts/verify-changed.mjs",
    "runs:show": "node scripts/show-runs.mjs",
    "measure:agent-context": "node scripts/measure-agent-context.mjs",
    "context:hotspots": "node scripts/context-hotspots.mjs",
    "new:plan": "node scripts/new-plan.mjs",
    "archive:plans": "node scripts/archive-plans.mjs",
    "plans:check": "node scripts/check-plans.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:check:final": "npm run archive:plans && node scripts/check-docs.mjs --final",
    "prune:transient": "node scripts/prune-transient-artifacts.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "sync:version": "node scripts/sync-version-metadata.mjs",
    "sync:steam-appid": "node scripts/sync-steam-appid.mjs",
    "sync:gear-art": "node scripts/sync-gear-art.mjs",
    "sync:assets": "node scripts/sync-assets.mjs",
    "sync:generated": "node scripts/sync-generated.mjs",
    "check:generated": "node scripts/sync-generated.mjs --check",
    "test:ship:unit": "node scripts/run-ship-unit.mjs",
    "test:ship:e2e": "playwright test tests/save-persistence.spec.ts tests/save-error-paths.spec.ts --project chromium",
    "test:ship:desktop": "playwright test --config playwright.electron.config.ts",
    "check:ship": "npm run lint:ci && npm run test:ship:unit && cross-env ALCHEMY_SKIP_ASSETS=1 npm run build:desktop && npm run check:bundle",
    "check:ship:full": "npm run check:ship && npm run test:ship:e2e",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "steam:upload": "node scripts/steam-upload.mjs",
    "steam:upload:dry-run": "cross-env STEAM_UPLOAD_DRY_RUN=1 node scripts/steam-upload.mjs",
    "clean": "node scripts/clean-dev-artifacts.mjs",
    "clean:all": "node scripts/clean-dev-artifacts.mjs --all",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "cross-env PLAYWRIGHT_VITE_MODE=preview playwright test --project chromium",
    "test:e2e:dev": "cross-env PLAYWRIGHT_VITE_MODE=dev playwright test --project chromium",
    "test:e2e:critical": "cross-env PLAYWRIGHT_VITE_MODE=preview playwright test --project chromium --grep \"@critical|@prepush\"",
    "test:e2e:prepush": "cross-env PLAYWRIGHT_VITE_MODE=preview PLAYWRIGHT_PREPUSH=1 playwright test --project chromium --grep @prepush",
    "test:e2e:prepush:full": "cross-env PLAYWRIGHT_VITE_MODE=preview CI=true npm run test:e2e:critical",
    "test:e2e:shop": "cross-env PLAYWRIGHT_VITE_MODE=preview playwright test tests/shop-and-rewards.spec.ts --project chromium",
    "test:e2e:audio": "cross-env PLAYWRIGHT_VITE_MODE=preview playwright test tests/audio-sfx.spec.ts --project chromium",
    "test:e2e:gear": "cross-env PLAYWRIGHT_VITE_MODE=preview playwright test tests/armory.spec.ts --project chromium",
    "test:e2e:mystery": "cross-env PLAYWRIGHT_VITE_MODE=preview playwright test tests/destination-progression.spec.ts -g Mystery --project chromium",
    "test:e2e:full": "cross-env PLAYWRIGHT_VITE_MODE=preview PLAYWRIGHT_E2E_FULL=1 CI=true playwright test --project chromium",
    "test:e2e:nightly": "cross-env PLAYWRIGHT_VITE_MODE=preview PLAYWRIGHT_E2E_FULL=1 PLAYWRIGHT_NIGHTLY=1 CI=true playwright test --project chromium",
    "test:e2e:timings": "cross-env PLAYWRIGHT_JSON_OUTPUT_NAME=reports/e2e-results.json PLAYWRIGHT_VITE_MODE=preview PLAYWRIGHT_E2E_FULL=1 CI=true playwright test --project chromium --reporter=json",
    "test:e2e:audit": "node scripts/analyze-e2e.mjs",
    "perf": "node scripts/run-performance.mjs",
    "perf:trace": "node scripts/run-performance.mjs --trace",
    "perf:compare": "node scripts/run-performance.mjs --compare",
    "balance:sim": "node scripts/run-balance-report.mjs && node scripts/open-report.mjs reports/balance-findings.html",
    "test:balance": "vitest run --config vitest.balance.config.ts",
    "check:push": "npm run format:check && npm run typecheck:all && npm run lint && cross-env ALCHEMY_SKIP_ASSETS=1 npm run build && npm run test:e2e:prepush",
    "lint": "eslint . --cache --max-warnings=0",
    "lint:boundaries": "depcruise src --config dependency-cruiser.config.mjs --output-type err",
    "lint:architecture-smoke": "node scripts/lint-architecture-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "typecheck:all": "concurrently \"tsc --noEmit\" \"tsc -p tsconfig.test.json --noEmit\"",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "lint:ci": "concurrently --kill-others-on-fail --max-process 4 --names docs,routing,generated,format,typecheck,eslint,boundaries,arch-smoke,knip \"npm run docs:check\" \"npm run ci:routing\" \"npm run check:generated\" \"npm run format:check\" \"npm run typecheck:all\" \"npm run lint\" \"npm run lint:boundaries\" \"npm run lint:architecture-smoke\" \"npm run deadcode\"",
    "format": "node scripts/run-prettier.mjs --write",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "deadcode": "knip --no-config-hints",
    "deadcode:strict": "knip --strict --include-entry-exports --exclude dependencies,unlisted",
    "format:check": "node scripts/run-prettier.mjs --check",
    "prepare": "lefthook install",
    "release": "node scripts/release.mjs",
    "release:hotfix": "node scripts/release-hotfix.mjs"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/electron": "^7.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^11.1.8",
    "lucide-react": "^1.37.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "steamworks.js": "^0.4.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.3",
    "@electron/get": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.4.0",
    "@stryker-mutator/core": "^10.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "commit-and-tag-version": "^12.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "lefthook": "^2.1.6",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vite-plugin-checker": "^0.13.0",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.alchemy.game",
    "productName": "Alchemy",
    "asar": true,
    "afterPack": "desktop/after-pack.cjs",
    "asarUnpack": [
      "**/node_modules/steamworks.js/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
