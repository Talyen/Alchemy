{
  "$schema": "https://opencode.ai/config.json",
  "shell": "zsh",
  "permission": {
    "bash": {
      "*": "allow",
      "git reset*": "deny",
      "git checkout --*": "deny",
      "git restore*": "deny",
      "git clean*": "deny",
      "git rebase --continue": "allow",
      "git rebase --abort": "allow",
      "git stash*": "ask"
    }
  }
}
